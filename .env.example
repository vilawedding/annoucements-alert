# ==================== TELEGRAM CONFIGURATION ====================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==================== EXCHANGE MONITORING ====================
# Enable/disable exchange monitoring
BINANCE_ENABLED=true
UPBIT_ENABLED=true
BITHUMB_ENABLED=false
# false = Bithumb alerts only from the cryptolisting.ws socket (needs Bithumb in the key's allowedCex)
BITHUMB_CRAWLER_ENABLED=true

# Check intervals (milliseconds)
BINANCE_INTERVAL=500
BITHUMB_INTERVAL=200

# Binance official announcement WebSocket (push, wss://api.binance.com/sapi/wss topic com_announcement_en).
# Needs a PRODUCTION Binance API key (read-only is enough; demo keys are rejected: "Invalid Api-Key ID.").
# Empty = falls back to BINANCE_API_KEY / _SECRET; none = REST polling only. Check: npm run check:binance-ws
BINANCE_ANNOUNCE_WS_ENABLED=true
BINANCE_ANNOUNCE_API_KEY=
BINANCE_ANNOUNCE_API_SECRET=

# Upbit REST polling. Upbit's Cloudflare rate limit is per IP and tight (HTTP 429 after a
# few requests). Polling is spread over the egress IPs: interval = UPBIT_PER_IP_MIN_INTERVAL_MS / IPs.
# Leave empty for auto (recommended); set a number only to force a fixed interval.
UPBIT_INTERVAL=
# Optional denser window around each whole minute (only ~10% of listings are published on :00)
UPBIT_BURST_PRE_MS=
UPBIT_BURST_POST_MS=
# REST interval while the WebSocket stream is connected (REST is only a fallback then)
UPBIT_WS_FALLBACK_INTERVAL=5000

# Egress IPs for Upbit REST polling (rate limit is per IP: N IPs = N x denser polling).
# Comma separated: direct, http://user:pass@host:port, socks5://user:pass@host:port
# Measure each IP first: node scripts/tests/probe-upbit-rate-limit.js <proxyUrl|direct>
UPBIT_PROXIES=direct
# ...or one proxy per line in a file (merged with UPBIT_PROXIES; UPBIT_PROXIES=none = file only).
# Formats: ip:port:user:pass | user:pass@ip:port | ip:port | http(s)/socks5 URL. See config/upbit_proxies.example.txt
# Docker: compose mounts UPBIT_PROXIES_FILE_HOST (default ./secrets/upbit_proxies.txt) into the container.
UPBIT_PROXIES_FILE=./secrets/upbit_proxies.txt
UPBIT_PROXIES_FILE_HOST=./secrets/upbit_proxies.txt
# Scheme for lines without one (http or socks5)
UPBIT_PROXY_DEFAULT_SCHEME=http
# Extra egress IPs via SSH tunnels (docker compose service `upbit-tunnels` opens them
# automatically and the bot adds one socks5h proxy per VM). Comma separated user@host[:sshPort].
# The private key that can log in to every VM: UPBIT_SSH_KEY_FILE (default ./secrets/upbit_tunnel_key)
UPBIT_SSH_TUNNELS=
UPBIT_SSH_KEY_FILE=./secrets/upbit_tunnel_key
# Min spacing between 2 requests from the same IP. Measured 2026-10-13 on a home IP: 0.1 req/s sustained,
# 0.15 req/s -> 429. 12500 = 0.1 req/s with 25% margin.
UPBIT_PER_IP_MIN_INTERVAL_MS=12500
# Burst spacing; leave empty = auto (UPBIT_PER_IP_MIN_INTERVAL_MS / number of IPs, min 50ms)
UPBIT_BURST_INTERVAL=
# Cooldown for an IP after 429 (418 ban = 4x)
UPBIT_RATE_LIMIT_BACKOFF_MS=60000

# Upbit private WebSocket announcement stream (push) - the primary low-latency source.
# Needs an Upbit API key (any permission). Leave keys empty to use REST polling only.
UPBIT_WS_ENABLED=true
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# cryptolisting.ws announcement socket - extra source for the enabled exchanges, traded like their own
# feeds (first source wins, later copies of the same notice are dropped). Upbit/Bithumb caution warnings
# are NOT sent by the service (only "caution released"), so Upbit WARNING trades still come from the crawler.
# Check the key: npm run check:cryptolisting
CRYPTOLISTING_ENABLED=false
CRYPTOLISTING_API_KEY=
# jp = Binance + Upbit + Bithumb, kr = Upbit + Bithumb
CRYPTOLISTING_WS_URL=wss://jp.cryptolisting.ws

# Bithumb notice feed (default already set in config)
# The buildId segment is refreshed automatically from BITHUMB_PAGE_URL when this returns 404
BITHUMB_API_URL=https://feed.bithumb.com/_next/data/NLILjNtdG9PdJyIGBALYd/notice.json?category=9&page=1
BITHUMB_PAGE_URL=https://feed.bithumb.com/notice?category=9&page=1

# Optional: if server IP is blocked by Cloudflare (403), copy cf_clearance cookie from browser session
BITHUMB_CF_CLEARANCE=

# Optional: full Cookie header from successful browser request (preferred when 403 persists)
# Example format: key1=value1; key2=value2; cf_clearance=...
BITHUMB_COOKIE=

# Health server port
PORT=3003

# ==================== AUTO-TRADING ====================
# Enable/disable auto-trading feature
AUTO_TRADE_ENABLED=false

# Trade on Upbit listing announcements
AUTO_TRADE_UPBIT_LISTING=true

# Trade on Bithumb listing announcements
# Backtest 2026-10-21 (54 Bithumb listings Apr-Oct 2026): LONG after the notice loses on Binance perp
# and Bybit spot (the market barely reacts) - keep alert-only.
AUTO_TRADE_BITHUMB_LISTING=false

# Trade on Binance listing announcements
AUTO_TRADE_BINANCE_LISTING=true

# Trade on Binance delisting announcements (SHORT). Only spot delists ("Binance Will Delist X on <date>")
# and USDⓈ-M futures delists are shorted; margin/loan/Alpha/pair-removal delists stay alert-only.
# Risk profile: BINANCE_DELISTING_LEVERAGE / _MARGIN (USDT) / _SL_PCT / _TP_PCT / _MAX_HOLD_MIN
AUTO_TRADE_BINANCE_DELISTING=true

# SHORT Upbit listings that open BTC/USDT markets only (no KRW) on the Binance perp, DELAY_SEC after the
# notice (the small pump fades). KRW listings are never shorted (they keep pumping; lost in every setup).
# Backtest 2026-10-21 (1s candles + funding, 58 listings 2023-2026, 10u x10): +160u, DD 19u, win 71%.
AUTO_TRADE_UPBIT_LISTING_SHORT=false
UPBIT_LISTING_SHORT_LEVERAGE=10
UPBIT_LISTING_SHORT_MARGIN=10
UPBIT_LISTING_SHORT_SL_PCT=5
UPBIT_LISTING_SHORT_MAX_HOLD_MIN=240
UPBIT_LISTING_SHORT_DELAY_SEC=60

# Upbit KRW listing of a token WITHOUT a Binance perp -> market BUY on Bybit SPOT, SL 5% on the last price
# (checked every second by the bot), market SELL at the time stop. Stablecoins and BTC/USDT-only listings
# are skipped. Backtest 2026-10-20 (26 listings 2023-2026, lag 5s): median +10.7% per trade, 65% win.
# Check the keys with a small round trip: npm run check:bybit-spot -- BTCUSDT 10
AUTO_TRADE_UPBIT_LISTING_BYBIT_SPOT=false
BYBIT_API_KEY=
BYBIT_API_SECRET=
# true = api-testnet.bybit.com (separate testnet account and keys)
BYBIT_TESTNET=true
# spot, no leverage: USDT spent per listing
BYBIT_SPOT_LISTING_MARGIN=100
BYBIT_SPOT_LISTING_SL_PCT=5
BYBIT_SPOT_LISTING_MAX_HOLD_MIN=15

# Strategy risk profiles (UPBIT_WARNING_ / UPBIT_DELISTING_ / BINANCE_DELISTING_ / BINANCE_LISTING_ prefix).
# Every trade uses ISOLATED margin (set ahead for all symbols at startup), so the max loss of a trade is its
# MARGIN (USDT, isolated) = the max loss of a trade; the order notional is MARGIN x LEVERAGE. When a symbol
# allows less leverage, the notional shrinks so the margin stays the same. Unset MARGIN = 10.
# Setup backtested 2026-10-20 (1s candles, lag 3-5s, 2023-01..2026-10): 10u margin x20.
UPBIT_WARNING_LEVERAGE=20
UPBIT_WARNING_MARGIN=10
UPBIT_WARNING_SL_PCT=2
UPBIT_WARNING_TP_PCT=0
UPBIT_WARNING_MAX_HOLD_MIN=1440
# Breakeven once the price moved +5% in the trade's favour; STEP 1000 = the SL is not moved again.
# Backtest 2026-10-22 at symbol-max leverage (~x50): total unchanged, lower drawdown; a step ladder cost 27-42%.
UPBIT_WARNING_TRAIL_ACTIVATE_PCT=5
UPBIT_WARNING_TRAIL_STEP_PCT=1000
UPBIT_WARNING_TRAIL_GIVEBACK_PCT=0
UPBIT_DELISTING_LEVERAGE=20
UPBIT_DELISTING_MARGIN=10
UPBIT_DELISTING_SL_PCT=3
UPBIT_DELISTING_TP_PCT=0
UPBIT_DELISTING_MAX_HOLD_MIN=720
# Binance delists: no TP, no trailing (the drop usually runs past 10%); SL 5% sits past the x20 liquidation,
# so the loss is capped at the margin.
BINANCE_DELISTING_LEVERAGE=20
BINANCE_DELISTING_MARGIN=10
BINANCE_DELISTING_SL_PCT=5
BINANCE_DELISTING_TP_PCT=0
BINANCE_DELISTING_MAX_HOLD_MIN=240
# Breakeven once the price moved +5% in the trade's favour (STEP 1000 = no further moves)
BINANCE_DELISTING_TRAIL_ACTIVATE_PCT=5
BINANCE_DELISTING_TRAIL_STEP_PCT=1000
BINANCE_DELISTING_TRAIL_GIVEBACK_PCT=0
# USDⓈ-M futures delists crash the moment Binance pushes the notice (~0.9s after publish), then bounce.
# Plan A: notice received <= RACE_MAX_MS after publish (or <= RACE_AFTER_PUSH_MS after a cryptolisting push)
# -> short at once, before the crash. Plan B: later -> wait until DELAY_SEC after the notice (past the bounce).
# Backtest 1s: entry 6-7s +2107u / DD 123u vs ~1s +1963u / DD 221u (all strategies). DELAY_SEC=0 = always immediate.
BINANCE_DELISTING_FUTURES_RACE_MAX_MS=850
BINANCE_DELISTING_FUTURES_RACE_AFTER_PUSH_MS=50
BINANCE_DELISTING_FUTURES_DELAY_SEC=6
# Trailing SL per strategy, in PRICE %: <PREFIX>_TRAIL_ACTIVATE_PCT (0 = off), _TRAIL_STEP_PCT (0 = activate),
# _TRAIL_GIVEBACK_PCT (0 = ladder only). Only Upbit delisting gained from it in the backtest.
UPBIT_DELISTING_TRAIL_ACTIVATE_PCT=5
UPBIT_DELISTING_TRAIL_STEP_PCT=0.5
UPBIT_DELISTING_TRAIL_GIVEBACK_PCT=2

# Listing LONG default profile: margin in USDT per position (notional = MARGIN x AUTO_TRADE_LEVERAGE)
AUTO_TRADE_MARGIN=1

# Leverage for futures trading (1-125x)
AUTO_TRADE_LEVERAGE=5
# true = use each symbol's own max leverage on every order (all profiles), ignoring the *_LEVERAGE values
AUTO_TRADE_LEVERAGE_MAX=true
# Upper bound on leverage for every order (0 = none)
AUTO_TRADE_LEVERAGE_CAP=0

AUTO_TRADE_SL_PERCENT=1.0          # Stop Loss %
AUTO_TRADE_TP_PERCENT=200.0        # Take Profit % (fallback)
AUTO_TRADE_TP_PERCENT_UPBIT=200.0
AUTO_TRADE_TP_PERCENT_BITHUMB=200.0
AUTO_TRADE_TP_PERCENT_BINANCE=200.0

# Execute MARKET first, then place TP/SL asynchronously for lower entry latency
AUTO_TRADE_MARKET_FIRST_ASYNC_PROTECTION=true

# Retry settings
# 1 = retry 1 time (total 2 attempts)
AUTO_TRADE_RETRY_COUNT=1
AUTO_TRADE_RETRY_DELAY_MS=50

# ==================== POSITION MANAGER (ported from pika ladder) ====================
# After the market entry: SL/TP on the Algo API, trailing SL by ROI step, close detection,
# PnL to TELEGRAM_PNL_CHAT_ID. ROI % is of margin (ROI% = price% x leverage).
POSITION_MANAGER_ENABLED=true
POSITION_POLL_MS=5000
# Initial SL in ROI %. Empty/0 = AUTO_TRADE_SL_PERCENT x leverage (previous behaviour)
TRAILING_INITIAL_SL_ROI_PCT=
# true = no TP order, exit only via SL / trailing (pika's setup)
POSITION_DISABLE_TP=false
# Trailing: level N triggers at ROI >= ACTIVATE + (N-1)*STEP and locks (N-1)*(STEP-BUFFER) % ROI
# (level 1 = breakeven unless FIRST_LOCK > 0). ACTIVATE=0 disables trailing.
TRAILING_ACTIVATE_ROI_PCT=50
TRAILING_STEP_ROI_PCT=25
TRAILING_LOCK_BUFFER_PCT=0
TRAILING_FIRST_LOCK_ROI_PCT=0
# Cap the giveback from the trigger ROI (0 = off, min 5)
TRAILING_MAX_GIVEBACK_ROI_PCT=0

# Ladder scale-in entry (pika) - ported but NOT used by the entry path yet; 1 = single market entry
LADDER_COUNT=1

# ==================== TELEGRAM CHATS ====================
# Announcements go to TELEGRAM_CHAT_ID; fills/order errors and PnL can go to separate groups
TELEGRAM_ORDER_CHAT_ID=
TELEGRAM_PNL_CHAT_ID=

# ==================== BINANCE DEMO TRADING ====================
# true = orders go to demo-fapi.binance.com with the demo keys (simulated funds)
BINANCE_USE_DEMO=false
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# ==================== BINANCE FUTURES API ====================
# Get API keys from:
# - Production: https://www.binance.com/en/my/settings/api-management
# - Testnet: https://testnet.binancefuture.com/

BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Use testnet for safety (recommended for testing)
# true = testnet, false = production
BINANCE_USE_TESTNET=true

# Orders over the Binance WebSocket API (kept-open connection, REST fallback). Demo uses the testnet ws-fapi host.
BINANCE_WS_ORDER_ENABLED=true
