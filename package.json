{
  "name": "crypto-monitor-bot",
  "version": "3.0.0",
  "description": "Multi-exchange cryptocurrency listing/delisting monitor with lightning-fast trading",
  "main": "index-new.js",
  "scripts": {
    "start": "node --require ./preload.js index-new.js",
    "dev": "nodemon --require ./preload.js index-new.js",
    "start:legacy": "node --require ./preload.js scripts/legacy/index-monolithic.js",
    "test": "node scripts/tests/test-integration.js",
    "test:auto-trade": "node --require ./preload.js scripts/tests/test-auto-trade.js",
    "example:binance": "node scripts/examples/binance-example.js",
    "test:crawler": "node scripts/tests/test-crawler.js",
    "check:upbit-ws": "node scripts/tests/check-upbit-ws.js",
    "probe:upbit": "node scripts/tests/probe-upbit-rate-limit.js",
    "probe:relay": "node scripts/tests/probe-relay.js",
    "test:positions": "node scripts/tests/test-position-manager.js",
    "test:cryptolisting": "node scripts/tests/test-cryptolisting.js",
    "check:cryptolisting": "node scripts/tests/check-cryptolisting.js",
    "test:bybit-spot": "node --require ./preload.js scripts/tests/test-bybit-spot.js",
    "check:bybit-spot": "node scripts/tests/check-bybit-spot.js",
    "check:binance-ws": "node scripts/tests/check-binance-announce-ws.js",
    "report:latency": "node scripts/report/source-latency-report.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "1.0.0-rc.12",
    "dotenv": "^16.3.0",
    "https-proxy-agent": "7.0.6",
    "node-telegram-bot-api": "^0.61.0",
    "socks-proxy-agent": "8.0.5",
    "undici": "5.28.2",
    "ws": "8.18.0"
  }
}
